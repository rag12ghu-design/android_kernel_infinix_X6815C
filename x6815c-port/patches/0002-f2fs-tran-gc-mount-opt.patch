From: Antigravity <antigravity@google.com>
Subject: [PATCH 2/4] fs/f2fs: Accept tran_gc mount option from stock X6815C fstab

Stock Infinix fstab.mt6877 mounts /data with the 'tran_gc' mount option.
Parse and safely acknowledge this option so /data mounts successfully.

---
 fs/f2fs/super.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/fs/f2fs/super.c b/fs/f2fs/super.c
index abcdef0..1234567 100644
--- a/fs/f2fs/super.c
+++ b/fs/f2fs/super.c
@@ -140,6 +140,7 @@ enum {
 	Opt_fsverity,
 	Opt_checkpoint_disable,
 	Opt_checkpoint_disable_cap,
+	Opt_tran_gc,
 	Opt_err,
 };
 
@@ -213,6 +214,7 @@ static match_table_t f2fs_tokens = {
 	{Opt_fsverity, "fsverity"},
 	{Opt_checkpoint_disable, "checkpoint=disable"},
 	{Opt_checkpoint_disable_cap, "checkpoint=disable:%u"},
+	{Opt_tran_gc, "tran_gc"},
 	{Opt_err, NULL},
 };
 
@@ -878,6 +880,10 @@ static int parse_options(struct super_block *sb, char *options)
 		case Opt_checkpoint_disable_cap:
 			set_opt(sbi, CHECKPOINT_DISABLE);
 			break;
+		case Opt_tran_gc:
+			/* Transsion custom GC flag in stock fstab - safely accepted */
+			set_opt(sbi, BG_GC);
+			break;
 		default:
 			f2fs_msg(sb, KERN_ERR,
 				"Unrecognized mount option \"%s\" or missing value",
-- 
2.34.1
