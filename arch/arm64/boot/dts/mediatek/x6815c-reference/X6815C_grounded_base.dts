/dts-v1/;
// version: 17
// last_comp_version: 16
// boot_cpuid_phys: 0x0

/ {
    model = "MT6877";
    compatible = "mediatek,MT6877";
    interrupt-parent = <0x1>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    chosen {
        bootargs = "console=tty0 console=ttyS0,921600n1 root=/dev/ram 			vmalloc=400M slub_debug=OFZPU swiotlb=noforce 			initcall_debug=1 			firmware_class.path=/vendor/firmware 			page_owner=on loop.max_part=7";
        kaslr-seed = <0x0 0x0>;
        phandle = <0x52>;
    };
    opp_table0 {
        compatible = "operating-points-v2";
        opp-shared;
        phandle = <0x2>;
        opp0 {
            opp-hz = <0x0 0x1DCD6500>;
            opp-microvolt = <0x9EB10>;
        };
        opp1 {
            opp-hz = <0x0 0x26BE3680>;
            opp-microvolt = <0x9EB10>;
        };
        opp2 {
            opp-hz = <0x0 0x2C1B8100>;
