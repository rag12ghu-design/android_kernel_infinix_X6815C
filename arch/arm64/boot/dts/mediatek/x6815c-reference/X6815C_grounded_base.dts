            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xE>;
        };
        cpu@005 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x500>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x111>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xF>;
        };
        cpu@100 {
            device_type = "cpu";
            compatible = "arm,cortex-a76";
            reg = <0x600>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x7>;
            dynamic-power-coefficient = <0x113>;
            capacity-dmips-mhz = <0x400>;
            cpu-idle-states = <0x8 0x9 0x5 0x6>;
            phandle = <0x10>;
        };
        cpu@101 {
            device_type = "cpu";
            compatible = "arm,cortex-a76";
            reg = <0x700>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x7>;
            dynamic-power-coefficient = <0x113>;
            capacity-dmips-mhz = <0x400>;
            cpu-idle-states = <0x8 0x9 0x5 0x6>;
            phandle = <0x11>;
        };
        cpu-map {
            cluster0 {
                core0 {
                    cpu = <0xA>;
                };
                core1 {
                    cpu = <0xB>;
                };
                core2 {
                    cpu = <0xC>;
                };
                core3 {
                    cpu = <0xD>;
                };
                core4 {
                    cpu = <0xE>;
                };
                core5 {
                    cpu = <0xF>;
                };
                doe {
                    phandle = <0xC9>;
                };
            };
            cluster1 {
                core0 {
                    cpu = <0x10>;
                };
                core1 {
                    cpu = <0x11>;
                };
                doe {
                    phandle = <0xCA>;
                };
            };
        };
        idle-states {
            entry-method = "arm,psci";
            cpuoff_l {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x10001>;
                local-timer-stop;
                entry-latency-us = <0x32>;
                exit-latency-us = <0x64>;
                min-residency-us = <0x640>;
                phandle = <0x3>;
            };
            cpuoff_b {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x10001>;
                local-timer-stop;
                entry-latency-us = <0x32>;
                exit-latency-us = <0x64>;
                min-residency-us = <0x578>;
                phandle = <0x8>;
            };
            clusteroff_l {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x1010001>;
                local-timer-stop;
                entry-latency-us = <0x64>;
                exit-latency-us = <0xFA>;
                min-residency-us = <0x834>;
                phandle = <0x4>;
            };
            clusteroff_b {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x1010001>;
                local-timer-stop;
                entry-latency-us = <0x64>;
                exit-latency-us = <0xFA>;
                min-residency-us = <0x76C>;
                phandle = <0x9>;
            };
            mcusysoff {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x1010002>;
                local-timer-stop;
                entry-latency-us = <0x12C>;
                exit-latency-us = <0x4B0>;
                min-residency-us = <0xA28>;
                phandle = <0x5>;
            };
            s2idle {
                compatible = "mediatek,idle-state";
                arm,psci-suspend-param = <0x1010100>;
                local-timer-stop;
                entry-latency-us = <0x1F4>;
                exit-latency-us = <0x578>;
                min-residency-us = <0xFFFFFFFF>;
                phandle = <0x6>;
            };
        };
    };
    disp_leds {
        compatible = "mediatek,disp-leds";
        backlight {
            label = "lcd-backlight";
            max-brightness = <0xFF>;
            led-bits = <0x8>;
            trans-bits = <0xB>;
            default-state = "on";
        };
    };
    pwmleds {
        compatible = "mediatek,disp-pwm-leds";
        backlight {
            label = "lcd-backlight";
            pwms = <0x12 0x0 0x99D9>;
            max-brightness = <0xFFF>;
            led-bits = <0xC>;
            trans-bits = <0xC>;
            pwm-names = "lcd-backlight";
            default-state = "on";
        };
    };
    i2c_leds {
        compatible = "mediatek,i2c-leds";
        backlight {
            label = "lcd-backlight";
            max-brightness = <0xFF>;
            led-bits = <0x8>;
            trans-bits = <0xB>;
            default-state = "on";
        };
    };
    mtk_lpm {
        compatible = "mediatek,mtk-lpm";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        suspend-method = "s2idle";
        cpupm-method = "mcu";
        irq-remain = <0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1A 0x1B 0x1C 0x1D 0x1E 0x1F 0x20 0x21 0x22 0x23>;
        resource-ctrl = <0x24 0x25 0x26 0x27 0x28>;
        constraints = <0x29 0x2A 0x2B>;
        phandle = <0xCB>;
        cpupm-sysram@0011b000 {
            compatible = "mediatek,cpupm-sysram";
            reg = <0x0 0x11B000 0x0 0x500>;
            phandle = <0xCC>;
        };
        lpm_sysram@0011b500 {
            compatible = "mediatek,lpm-sysram";
            reg = <0x0 0x11B500 0x0 0x300>;
            phandle = <0xCD>;
        };
        irq-remain-list {
            edge_keypad {
                target = <0x2C>;
                value = <0x1 0x0 0x0 0x4>;
                phandle = <0x13>;
            };
            edge_mdwdt {
                target = <0x2D>;
                value = <0x1 0x0 0x80000000 0x2000000>;
                phandle = <0x14>;
            };
            level_vpu_core0 {
                target = <0x2E>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x15>;
            };
            level_vpu_core1 {
                target = <0x2F>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x16>;
            };
            level_mtk_mdla0 {
                target = <0x30>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x17>;
            };
            level_edma0 {
                target = <0x31>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x18>;
            };
            level_mali0 {
                target = <0x32>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x19>;
            };
            level_mali1 {
                target = <0x32>;
                value = <0x0 0x1 0x0 0x0>;
                phandle = <0x1A>;
            };
            level_mali2 {
                target = <0x32>;
                value = <0x0 0x2 0x0 0x0>;
                phandle = <0x1B>;
            };
            level_mali3 {
                target = <0x32>;
                value = <0x0 0x3 0x0 0x0>;
