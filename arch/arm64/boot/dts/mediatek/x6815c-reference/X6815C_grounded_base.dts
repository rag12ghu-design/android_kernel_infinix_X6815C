        };
        opp15 {
            opp-hz = <0x0 0x77359400>;
            opp-microvolt = <0xF4240>;
        };
    };
    opp_table1 {
        compatible = "operating-points-v2";
        opp-shared;
        phandle = <0x7>;
        opp0 {
            opp-hz = <0x0 0x26BE3680>;
            opp-microvolt = <0x9EB10>;
        };
        opp1 {
            opp-hz = <0x0 0x2C1B8100>;
            opp-microvolt = <0xA344E>;
        };
        opp2 {
            opp-hz = <0x0 0x363D7F80>;
            opp-microvolt = <0xAC6CA>;
        };
        opp3 {
            opp-hz = <0x0 0x3DFD2400>;
            opp-microvolt = <0xB2872>;
        };
        opp4 {
            opp-hz = <0x0 0x43F30500>;
            opp-microvolt = <0xB71B0>;
        };
        opp5 {
            opp-hz = <0x0 0x4D7C6D00>;
            opp-microvolt = <0xBEBC2>;
        };
        opp6 {
            opp-hz = <0x0 0x553C1180>;
            opp-microvolt = <0xC4D6A>;
        };
        opp7 {
            opp-hz = <0x0 0x5BCA8900>;
            opp-microvolt = <0xCAF12>;
        };
        opp8 {
            opp-hz = <0x0 0x62F19700>;
            opp-microvolt = <0xCF850>;
        };
        opp9 {
            opp-hz = <0x0 0x6B49D200>;
            opp-microvolt = <0xD418E>;
        };
        opp10 {
            opp-hz = <0x0 0x713FB300>;
            opp-microvolt = <0xD59F8>;
        };
        opp11 {
            opp-hz = <0x0 0x77359400>;
            opp-microvolt = <0xD8ACC>;
        };
        opp12 {
            opp-hz = <0x0 0x80266580>;
            opp-microvolt = <0xDBBA0>;
        };
        opp13 {
            opp-hz = <0x0 0x8583B000>;
            opp-microvolt = <0xE975A>;
        };
        opp14 {
            opp-hz = <0x0 0x8A486400>;
            opp-microvolt = <0xF5AAA>;
        };
        opp15 {
            opp-hz = <0x0 0x8F0D1800>;
            opp-microvolt = <0x100590>;
        };
    };
    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu@000 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x0>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x111>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xA>;
        };
        cpu@001 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x100>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x111>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xB>;
        };
        cpu@002 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x200>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x111>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xC>;
        };
        cpu@003 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x300>;
            enable-method = "psci";
            clock-frequency = <0x77359400>;
            operating-points-v2 = <0x2>;
            dynamic-power-coefficient = <0x55>;
            capacity-dmips-mhz = <0x111>;
            cpu-idle-states = <0x3 0x4 0x5 0x6>;
            phandle = <0xD>;
        };
        cpu@004 {
            device_type = "cpu";
            compatible = "arm,cortex-a55";
            reg = <0x400>;
            enable-method = "psci";
