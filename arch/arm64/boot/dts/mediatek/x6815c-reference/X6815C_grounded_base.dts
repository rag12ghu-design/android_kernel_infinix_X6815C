            };
            level_i2c0 {
                target = <0x33>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x1E>;
            };
            level_btif_tx {
                target = <0x34>;
                value = <0x0 0x1 0x0 0x0>;
                phandle = <0x1F>;
            };
            level_btif_rx {
                target = <0x34>;
                value = <0x0 0x2 0x0 0x0>;
                phandle = <0x20>;
            };
            level_bt {
                target = <0x35>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x21>;
            };
            level_cam1 {
                target = <0x36>;
                value = <0x0 0x0 0x0 0x0>;
                phandle = <0x22>;
            };
            level_cam2 {
                target = <0x37>;
                value = <0x0 0x1 0x0 0x0>;
                phandle = <0x23>;
            };
        };
        resource-ctrl-list {
            bus26m {
                id = <0x0>;
                value = <0x0>;
                phandle = <0x24>;
            };
            infra {
                id = <0x1>;
                value = <0x0>;
                phandle = <0x25>;
            };
            syspll {
                id = <0x2>;
                value = <0x0>;
                phandle = <0x26>;
            };
            dram_s0 {
                id = <0x3>;
                value = <0x0>;
                phandle = <0x27>;
            };
            dram_s1 {
                id = <0x4>;
                value = <0x0>;
                phandle = <0x28>;
            };
        };
        constraint-list {
            rc_bus26m {
                id = <0x0>;
                value = <0x1>;
                phandle = <0x29>;
            };
            rc_syspll {
                id = <0x1>;
                value = <0x1>;
                phandle = <0x2A>;
            };
            rc_dram {
                id = <0x2>;
                value = <0x1>;
                phandle = <0x2B>;
            };
        };
    };
    mcusys-ctrl@0c53a000 {
        compatible = "mediatek,mcusys-ctrl";
        reg = <0x0 0xC53A000 0x0 0x1000>;
        phandle = <0xCE>;
    };
    pmu {
        compatible = "arm,armv8-pmuv3";
        interrupt-parent = <0x1>;
        interrupts = <0x1 0x7 0x4>;
    };
    dsu-pmu-0 {
        compatible = "arm,dsu-pmu";
        interrupts = <0x0 0x12 0x4>;
        cpus = <0xA 0xB 0xC 0xD 0xE 0xF 0x10 0x11>;
    };
    memory {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x3E605000>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    reserved-memory {
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        phandle = <0xCF>;
        ssmr-reserved-cma_memory {
            compatible = "shared-dma-pool";
            reusable;
            size = <0x0 0x10000000>;
            alignment = <0x0 0x1000000>;
            alloc-range = <0x0 0xC0000000 0x0 0x10000000>;
            phandle = <0x57>;
        };
        reserve-memory-mcupm_share {
            compatible = "mediatek,reserve-memory-mcupm_share";
            no-map;
            status = "okay";
            size = <0x0 0x610000>;
            alignment = <0x0 0x10000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x60000000>;
        };
        ion-carveout-heap {
            compatible = "mediatek,ion-carveout-heap";
            no-map;
            size = <0x0 0xC000>;
            alignment = <0x0 0x1000>;
            alloc-ranges = <0x0 0x40000000 0x0 0x80000000>;
