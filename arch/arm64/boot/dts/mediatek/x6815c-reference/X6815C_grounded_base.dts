        };
        opp10 {
            opp-hz = <0x0 0x5995F5C0>;
            opp-microvolt = <0xCAF12>;
        };
        opp11 {
            opp-hz = <0x0 0x5F5E1000>;
            opp-microvolt = <0xCF850>;
        };
        opp12 {
            opp-hz = <0x0 0x6581B7C0>;
            opp-microvolt = <0xDA336>;
        };
        opp13 {
            opp-hz = <0x0 0x6B49D200>;
