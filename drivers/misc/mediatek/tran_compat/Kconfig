# Transsion (Infinix / Tecno / itel) Compatibility Layer Kconfig
# Provides explicit Kconfig definitions and clean stubs for proprietary OEM extensions

menuconfig TRAN_COMPAT
	bool "Transsion Hardware and Subsystem Compatibility Layer"
	default y
	help
	  Enables compatibility symbols, stubs, and interfaces for Transsion
	  (Infinix Zero 5G 2023 / X6815C) proprietary hardware and daemon hooks.

